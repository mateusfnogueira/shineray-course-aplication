# ================================================
# Compliance Training Platform — Environment Config
# ================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# All secrets must be generated before going to production.
#
# ── EC2 Single-Instance Deployment ──────────────
# Instance: shineray-course-aplication-01 (i-01c171ea1087ce5d5)
# Public IP: 34.205.64.35
# DNS:       ec2-34-205-64-35.compute-1.amazonaws.com
#
# Deploy:
#   1. cp .env.example .env && nano .env        # fill secrets
#   2. docker compose -f docker-compose.prod.yml up -d --build
#
# Security Groups required (inbound):
#   - TCP 22    — SSH (your IP only)
#   - TCP 3000  — Web frontend
#   - TCP 3001  — API (optional: restrict to same SG)
#   - TCP 9000  — MinIO S3 (optional: restrict if using only internally)
#   - TCP 9001  — MinIO Console (restrict to your IP only)

# ─── Application ────────────────────────────────
NODE_ENV=production
PORT=3001

# ─── Frontend ───────────────────────────────────
# Build-time args — must match the public URL where the app will be accessed.
# If you add a domain later, replace the IP with the domain name.
NEXT_PUBLIC_API_URL=http://34.205.64.35:3001
NEXT_PUBLIC_APP_URL=http://34.205.64.35:3000

# ─── Database ───────────────────────────────────
# Postgres runs as a container on the internal Docker network.
# DATABASE_URL is resolved inside the api container via the service name "postgres".
DB_USER=compliance
DB_PASSWORD=journeyDev2026
DB_NAME=compliance_prod
DATABASE_URL=postgresql://compliance:journeyDev2026@postgres:5432/compliance_prod

# ─── JWT ────────────────────────────────────────
# Generate both with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=bd78f7e0622002ff41ef6c7c3a8c7858016cc7f8a442b2061df6a853122b77672ab25f4a02f32d94dc16f3871c14568b5463af9d93e7fe3af9002c2cd60fabc5
JWT_REFRESH_SECRET=bd78f7e0622002ff41ef6c7c3a8c7858016cc7f8a442b2061df6a853122b77672ab25f4a02f32d94dc16f3871c14568b5463af9d93e7fe3af9002c2cd60fabc5
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────
# Allow the frontend origin. Add comma-separated origins if needed.
CORS_ORIGIN=http://34.205.64.35:3000

# ─── Email (SMTP) ───────────────────────────────
# Use an external provider (SES, Brevo, Mailgun, etc.).
# Example values below are for Brevo (formerly Sendinblue).
# For testing, point to a local Mailpit or leave dummy values (emails will fail silently).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@compliance.local
SMTP_FROM_NAME=Compliance Training

# ─── Storage (MinIO — S3-compatible, runs as container) ─
# MINIO_ENDPOINT must be the public IP so pre-signed URLs are reachable from the browser.
STORAGE_DRIVER=minio
MINIO_ENDPOINT=34.205.64.35
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=compliance

# ─── Redis (BullMQ queue backend) ───────────────
# Redis runs as a container; resolved via service name inside Docker network.
REDIS_URL=redis://redis:6379

# ─── Rate Limiting ──────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# ─── Auth Security ──────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION_MINUTES=15
ACTIVATION_TOKEN_TTL_HOURS=48
RESET_PASSWORD_TOKEN_TTL_HOURS=2
