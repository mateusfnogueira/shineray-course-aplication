# ================================================
# Compliance Training Platform — Environment Config
# ================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# All secrets must be generated before going to production.

# ─── Application ────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Frontend ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ───────────────────────────────────
DB_USER=compliance
DB_PASSWORD=compliance
DB_NAME=compliance_dev
DATABASE_URL=postgresql://compliance:compliance@localhost:5432/compliance_dev
DATABASE_TEST_URL=postgresql://compliance:compliance@localhost:5433/compliance_test

# ─── JWT ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_THIS_ACCESS_SECRET_MIN_64_CHARS_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_MIN_64_CHARS_IN_PRODUCTION
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# ─── Email (Mailpit for development) ────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@compliance.local
SMTP_FROM_NAME=Compliance Training

# ─── Storage (MinIO for local / S3-compatible) ──
STORAGE_DRIVER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=compliance

# ─── Redis (future queue support) ───────────────
REDIS_URL=redis://localhost:6379

# ─── Rate Limiting ──────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# ─── Auth Security ──────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_DURATION_MINUTES=15
ACTIVATION_TOKEN_TTL_HOURS=48
RESET_PASSWORD_TOKEN_TTL_HOURS=2
