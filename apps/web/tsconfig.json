{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@compliance/typescript-config/nextjs.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@compliance/shared": ["../../packages/shared/src"],
      "@compliance/shared/*": ["../../packages/shared/src/*"],
      "@compliance/validation": ["../../packages/validation/src"],
      "@compliance/validation/*": ["../../packages/validation/src/*"],
      "@compliance/ui": ["../../packages/ui/src"],
      "@compliance/ui/*": ["../../packages/ui/src/*"],
      "@compliance/api-client": ["../../packages/api-client/src"],
      "@compliance/api-client/*": ["../../packages/api-client/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/types/**/*.tsx",
    ".next/types/**/*.d.ts",
    ".next/types/**/*.js",
    ".next/types/**/*.jsx"
  ],
  "exclude": ["node_modules", "e2e/**"]
}
