{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@compliance/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@compliance/shared": ["../shared/src"],
      "@compliance/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
